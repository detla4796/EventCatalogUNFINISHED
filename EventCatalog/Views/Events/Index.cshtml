@model List<EventCatalog.Models.Event>
@{ ViewBag.Title = "Каталог мероприятий"; }

<h2>Каталог мероприятий</h2>

<form id="filterForm" method="get" action="@Url.Action("Index")" class="form-inline" style="margin-bottom:15px">
    @Html.DropDownList("category", (SelectList)ViewBag.Categories, "Все категории", new { @class = "form-control" })
    <input type="number" name="minPrice" min="0" placeholder="Цена от" class="form-control" />
    <input type="number" name="maxPrice" min="0" placeholder="Цена до" class="form-control" />
    <input type="text" name="search" placeholder="Поиск по названию" class="form-control" />
    <button type="submit" class="btn btn-default">Найти</button>
</form>

<div id="eventList" data-url="@Url.Action("Filter")">
    @Html.Partial("_EventList", Model)
</div>

@section Scripts {
    <script src="~/Scripts/app/events-filter.js"></script>
}