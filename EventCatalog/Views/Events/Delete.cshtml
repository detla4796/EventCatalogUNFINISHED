@model EventCatalog.Models.Event
@{ ViewBag.Title = "Удаление мероприятия"; }

<h2>Удалить мероприятие?</h2>

<dl class="dl-horizontal">
    <dt>Название</dt>
    <dd>@Model.Title</dd>
    <dt>Категория</dt>
    <dd>@Model.Category.Name</dd>
    <dt>Дата</dt>
    <dd>@Model.StartDate.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

@using (Html.BeginForm("Delete", "Events", new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Удалить</button>
    @Html.ActionLink("Отмена", "Manage", null, new { @class = "btn btn-default" })
}